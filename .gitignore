# Track the plugin, user-facing documentation, license, and Git rules only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/package.json
!/dsh.plugin.json
!/cordis.patch.yml
!/lib/
!/drivers/
!/locale/
!/docs/
/docs/*
!/docs/README.md
!/docs/README.en.md
!/docs/installation.md
!/docs/installation.en.md
!/docs/tools.md
!/docs/tools.en.md
!/docs/configuration.md
!/docs/configuration.en.md
!/docs/runtime.md
!/docs/runtime.en.md
!/docs/api/
/docs/api/*
!/docs/api/openapi.json
!/docs/api/openapi.en.json
!/docs/api/README.md
!/docs/api/README.en.md

node_modules/
.codex-runner/
*.tgz
*.log
*.tmp
.env
.env.*
!.env.example
coverage/
test-results/

# Historical working notes, one-off scripts and obsolete test output.
/tasks/
# Unimplemented upstream proposal; not part of this plugin version.
/docs/upstream-settings-row.md

*.jsonl
*.bak
*.orig
*.rej
.DS_Store
Thumbs.db
