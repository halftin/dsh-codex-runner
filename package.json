{
  "name": "dsh-codex-runner",
  "version": "0.5.0-rc.2",
  "description": "Run and manage Codex CLI tasks in DSH with complete answers, background execution, live settings, optional quota reminders and recovery, and experimental model and reasoning-effort selection",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "codex-cli",
    "agent",
    "orchestration"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "drivers",
    "locale/*.json",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/README.md",
    "docs/README.en.md",
    "docs/installation.md",
    "docs/installation.en.md",
    "docs/tools.md",
    "docs/tools.en.md",
    "docs/configuration.md",
    "docs/configuration.en.md",
    "docs/runtime.md",
    "docs/runtime.en.md",
    "docs/api/openapi.json",
    "docs/api/openapi.en.json",
    "docs/api/README.md",
    "docs/api/README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halftin/dsh-codex-runner.git"
  },
  "homepage": "https://github.com/halftin/dsh-codex-runner#readme",
  "bugs": {
    "url": "https://github.com/halftin/dsh-codex-runner/issues"
  },
  "os": [
    "win32"
  ]
}
